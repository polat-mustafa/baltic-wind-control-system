# Baltic Wind HV Control Platform — Environment Variables
#
# Copy this file to .env and adjust values for your environment.
# All variables have sensible defaults for local development.

# Application
APP_NAME=Baltic Wind HV Control Platform
DEBUG=false

# Database (PostgreSQL 16 + TimescaleDB)
# For Docker: postgresql+asyncpg://postgres:postgres@postgres:5432/balticwind
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/balticwind

# Redis 7 (caching layer)
# For Docker: redis://redis:6379/0
REDIS_URL=redis://localhost:6379/0

# CORS allowed origins (JSON array)
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
