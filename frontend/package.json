{
  "name": "offshoreforge-frontend",
  "private": true,
  "version": "0.1.0",
  "description": "Frontend for the 510 MW Baltic Sea Offshore Wind HV Control Simulation Platform",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.build.json && vite build",
    "preview": "vite preview",
    "lint": "eslint src/ showcase/ e2e-demo/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "e2e:update": "playwright test --update-snapshots",
    "demo:record": "node scripts/demo.mjs record",
    "demo:check": "node scripts/demo.mjs check",
    "build:demo": "node scripts/build-demo.mjs",
    "i18n:missing": "node scripts/i18n-missing.mjs"
  },
  "dependencies": {
    "@deck.gl/core": "9.3.11",
    "@deck.gl/extensions": "9.3.11",
    "@deck.gl/layers": "9.3.11",
    "@deck.gl/react": "9.3.11",
    "@deck.gl/widgets": "9.3.11",
    "@radix-ui/react-dialog": "^1.2.0",
    "@radix-ui/react-tabs": "^1.1.22",
    "@radix-ui/react-tooltip": "^1.3.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "@react-three/postprocessing": "^3.1.3",
    "@xyflow/react": "^12.12.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^13.5.0",
    "lucide-react": "^1.53.0",
    "maplibre-gl": "5.24.0",
    "plotly.js-dist-min": "^4.1.2",
    "postprocessing": "^6.39.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-map-gl": "8.1.3",
    "react-markdown": "^10.1.0",
    "react-plotly.js": "^2.6.0",
    "react-router-dom": "^7.18.4",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.7.0",
    "three": "^0.186.1",
    "zustand": "^5.0.15"
  },
  "overrides": {
    "flatted": "^3.4.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "^10.0.0",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-plotly.js": "^2.6.4",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.12.0",
    "eslint-plugin-react-compiler": "^19.1.0-rc.2",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
