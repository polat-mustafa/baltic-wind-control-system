    "clsx": "^2.1.1",
    "d3-selection": "^3.0.0",
    "d3-zoom": "^3.0.0",
    "framer-motion": "^12.38.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.7.0",
    "plotly.js-dist-min": "^3.5.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
